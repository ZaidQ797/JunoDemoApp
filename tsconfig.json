{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "@screens": ["screens"],
      "@screens/*": ["screens/*"],
      "@components/*": ["components/*"],
      "@navigation/*": ["navigation/*"],
      "@redux/*": ["redux/*"],
      "@slices": ["redux/slices"],
      "@slices/*": ["redux/slices/*"],
      "@services": ["services"],
      "@utils/*": ["utils/*"]
    }
  }
}
